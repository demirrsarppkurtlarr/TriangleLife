# ============================================================
# TriangleLife — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# cp .env.example .env.local
# ============================================================

# ------------------------------------------------------------
# Supabase (zorunlu — üretim ve bulut kayıt için)
# Dashboard → Settings → API
# ------------------------------------------------------------
# Proje URL'i (Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon / public API anahtarı (anon public)
# Tarayıcıya açık olabilir; RLS politikaları koruma sağlar.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ------------------------------------------------------------
# Uygulama
# ------------------------------------------------------------
# development | production
NODE_ENV=development

# Lokal geliştirmede Next.js varsayılanı 3000'tir.
# Render'da PORT otomatik atanır; elle ayarlamanız gerekmez.
# PORT=3000

# Next.js telemetri (opsiyonel)
# NEXT_TELEMETRY_DISABLED=1
